{
  // ============================================================
  // EKYAN Connect — MCP Server Configuration
  // Synced with /.mcp.json — this file is the annotated source
  // of truth; .mcp.json is the clean runtime version.
  // ============================================================

  "mcpServers": {

    // ── SOURCE CONTROL ─────────────────────────────────────────
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@latest"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}" }
    },

    // ── LOCAL FILESYSTEM ───────────────────────────────────────
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@latest",
        "/Users/eric/EKYAN-AI-Agritech-Framework"
      ]
    },

    // ── DATABASE & GIS ─────────────────────────────────────────
    // PostgreSQL + PostGIS + TimescaleDB via Supabase
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--access-token", "${SUPABASE_ACCESS_TOKEN}"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}",
        "SUPABASE_PROJECT_REF": "${EKYAN_SUPABASE_PROJECT_REF}"
      }
    },

    // ── AI / LLM ───────────────────────────────────────────────
    // Swahili STT (Chirp), RAG advisory, credit score explanations
    "vertex-ai": {
      "command": "npx",
      "args": ["-y", "@google-cloud/vertex-ai-mcp-server@latest"],
      "env": {
        "GOOGLE_CLOUD_PROJECT": "${EKYAN_GCP_PROJECT_ID}",
        "GOOGLE_CLOUD_LOCATION": "${EKYAN_GCP_REGION}",
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}"
      }
    },

    // ── EARTH OBSERVATION ──────────────────────────────────────
    // NDVI, soil moisture, land-cover per farm plot
    "earth-engine": {
      "command": "npx",
      "args": ["-y", "@google/earthengine-mcp-server@latest"],
      "env": {
        "EE_SERVICE_ACCOUNT": "${EE_SERVICE_ACCOUNT}",
        "EE_PRIVATE_KEY": "${EE_PRIVATE_KEY}",
        "GOOGLE_CLOUD_PROJECT": "${EKYAN_GCP_PROJECT_ID}"
      }
    },
    // Sentinel-2 multispectral imagery — canopy moisture, early blight detection
    "sentinel-hub": {
      "command": "npx",
      "args": ["-y", "@sentinel-hub/mcp-server@latest"],
      "env": {
        "SH_CLIENT_ID": "${SENTINEL_HUB_CLIENT_ID}",
        "SH_CLIENT_SECRET": "${SENTINEL_HUB_CLIENT_SECRET}"
      }
    },

    // ── MESSAGING ──────────────────────────────────────────────
    // Primary channel: voice notes, weather nudges, market alerts
    "whatsapp": {
      "command": "npx",
      "args": ["-y", "@meta/whatsapp-business-mcp@latest"],
      "env": {
        "WHATSAPP_ACCESS_TOKEN": "${WHATSAPP_ACCESS_TOKEN}",
        "WHATSAPP_PHONE_NUMBER_ID": "${WHATSAPP_PHONE_NUMBER_ID}",
        "WHATSAPP_BUSINESS_ACCOUNT_ID": "${WHATSAPP_BUSINESS_ACCOUNT_ID}"
      }
    },
    // USSD fallback for feature phones + SMS for 2G/3G ASALs
    "africastalking": {
      "command": "npx",
      "args": ["-y", "@africastalking/mcp-server@latest"],
      "env": {
        "AT_API_KEY": "${AFRICASTALKING_API_KEY}",
        "AT_USERNAME": "${AFRICASTALKING_USERNAME}"
      }
    },

    // ── MOBILE MONEY ───────────────────────────────────────────
    // M-Pesa transaction history → credit scoring features
    "mpesa": {
      "command": "npx",
      "args": ["-y", "@safaricom/mpesa-mcp-server@latest"],
      "env": {
        "MPESA_CONSUMER_KEY": "${MPESA_CONSUMER_KEY}",
        "MPESA_CONSUMER_SECRET": "${MPESA_CONSUMER_SECRET}",
        "MPESA_BUSINESS_SHORT_CODE": "${MPESA_BUSINESS_SHORT_CODE}",
        "MPESA_PASSKEY": "${MPESA_PASSKEY}",
        "MPESA_ENVIRONMENT": "${MPESA_ENVIRONMENT}"
      }
    },

    // ── WEATHER ────────────────────────────────────────────────
    // Free hyperlocal forecasts — daily nudge engine
    "weather-openmeteo": {
      "command": "npx",
      "args": ["-y", "@open-meteo/mcp-server@latest"],
      "env": { "OPEN_METEO_BASE_URL": "https://api.open-meteo.com/v1" }
    },
    // Premium resolution for ASAL drought-risk early warning
    "weather-tomorrow": {
      "command": "npx",
      "args": ["-y", "@tomorrow-io/mcp-server@latest"],
      "env": { "TOMORROW_API_KEY": "${TOMORROW_IO_API_KEY}" }
    },

    // ── WEB SEARCH & SCRAPING ──────────────────────────────────
    // Market prices, pest alerts, agronomic knowledge grounding
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search@latest"],
      "env": { "BRAVE_API_KEY": "${BRAVE_API_KEY}" }
    },
    // Scrape KACE / Wakulima market price boards where no API exists
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer@latest"]
    },
    // Hit Sentinel Hub, Open Meteo, Twilio APIs directly
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch@latest"]
    },

    // ── TASK QUEUE ─────────────────────────────────────────────
    // Celery broker: NDVI pulls, nudge dispatch, SLA sweeps
    "redis": {
      "command": "npx",
      "args": ["-y", "@redis/mcp-server@latest"],
      "env": { "REDIS_URL": "${EKYAN_REDIS_URL}" }
    },

    // ── LIVE DOCS ──────────────────────────────────────────────
    // Pulls current docs for FastAPI, XGBoost, TFLite, LangChain
    // Eliminates hallucinated library APIs during RAD
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },

    // ── REASONING ──────────────────────────────────────────────
    // Multi-step logic for underwriting rules and climate chains
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking@latest"]
    },

    // ══════════════════════════════════════════════════════════
    // UI & FRONTEND LAYER
    // ══════════════════════════════════════════════════════════

    // Design → Code: reads Figma frames, extracts tokens,
    // generates React/TailwindCSS for all 3 EKYAN surfaces
    "figma": {
      "command": "npx",
      "args": ["-y", "@figma/mcp-server@latest"],
      "env": { "FIGMA_PERSONAL_ACCESS_TOKEN": "${FIGMA_PERSONAL_ACCESS_TOKEN}" }
    },

    // GIS layers: NDVI choropleth, farm plot polygons,
    // buyer route optimisation, offline tile caching for 2G
    "mapbox": {
      "command": "npx",
      "args": ["-y", "@mapbox/mcp-server@latest"],
      "env": { "MAPBOX_ACCESS_TOKEN": "${MAPBOX_ACCESS_TOKEN}" }
    },

    // Deploys Next.js M&E dashboard + agripreneur PWA
    // Edge functions proxy weather/market keys server-side
    "vercel": {
      "command": "npx",
      "args": ["-y", "@vercel/mcp-adapter@latest"],
      "env": {
        "VERCEL_TOKEN": "${VERCEL_TOKEN}",
        "VERCEL_TEAM_ID": "${VERCEL_TEAM_ID}"
      }
    },

    // React Native offline agripreneur app
    // OTA updates, EAS builds, expo-camera → TFLite, expo-sqlite
    "expo": {
      "command": "npx",
      "args": ["-y", "@expo/mcp-server@latest"],
      "env": {
        "EXPO_TOKEN": "${EXPO_TOKEN}",
        "EXPO_ACCOUNT_NAME": "${EXPO_ACCOUNT_NAME}"
      }
    },

    // Multilingual advisory content (Swahili/English)
    // Extension officers update content without code deploys
    "contentful": {
      "command": "npx",
      "args": ["-y", "@contentful/mcp-server@latest"],
      "env": {
        "CONTENTFUL_SPACE_ID": "${CONTENTFUL_SPACE_ID}",
        "CONTENTFUL_ACCESS_TOKEN": "${CONTENTFUL_ACCESS_TOKEN}",
        "CONTENTFUL_MANAGEMENT_TOKEN": "${CONTENTFUL_MANAGEMENT_TOKEN}",
        "CONTENTFUL_ENVIRONMENT": "master"
      }
    },

    // Runtime error capture: React Native crashes, Next.js SSR,
    // FastAPI exceptions — session replay for field bug reports
    "sentry": {
      "command": "npx",
      "args": ["-y", "@sentry/mcp-server@latest"],
      "env": {
        "SENTRY_AUTH_TOKEN": "${SENTRY_AUTH_TOKEN}",
        "SENTRY_ORG": "${SENTRY_ORG}",
        "SENTRY_PROJECT": "${SENTRY_PROJECT}"
      }
    },

    // Privacy-safe analytics — self-hostable for UNICEF data sovereignty
    // Tracks feature adoption, session funnels, drop-off by county
    "posthog": {
      "command": "npx",
      "args": ["-y", "@posthog/mcp-server@latest"],
      "env": {
        "POSTHOG_API_KEY": "${POSTHOG_API_KEY}",
        "POSTHOG_HOST": "${POSTHOG_HOST}"
      }
    },

    // WCAG 2.1 AA: large touch targets, outdoor contrast,
    // screen reader compat, keyboard nav for M&E dashboard
    "axe": {
      "command": "npx",
      "args": ["-y", "@axe-core/mcp-server@latest"]
    },

    // Shared component library: PWA + dashboard + supplier portal
    // Storybook interaction tests run headlessly in CI
    "storybook": {
      "command": "npx",
      "args": [
        "-y",
        "@storybook/mcp-server@latest",
        "--config-dir",
        "/Users/eric/EKYAN-AI-Agritech-Framework/.storybook"
      ]
    }
  }
}
