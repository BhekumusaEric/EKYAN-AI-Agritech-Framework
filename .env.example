# ============================================================
# EKYAN Connect — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to git — it is in .gitignore.
# During MVP use sandbox/staging values only.
# ============================================================

# ── Google Cloud ──────────────────────────────────────────────
EKYAN_GCP_PROJECT_ID=your-gcp-project-id
EKYAN_GCP_REGION=africa-south1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/ekyan-service-account.json

# ── Supabase (PostgreSQL / PostGIS / TimescaleDB) ─────────────
SUPABASE_ACCESS_TOKEN=your-supabase-pat
EKYAN_SUPABASE_PROJECT_REF=your-project-ref
# Connection string used by FastAPI / SQLAlchemy
DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# ── Google Earth Engine ───────────────────────────────────────
EE_SERVICE_ACCOUNT=ekyan-gee@your-project.iam.gserviceaccount.com
EE_PRIVATE_KEY=/path/to/ekyan-gee-key.json

# ── Sentinel Hub (Copernicus / Sentinel-2) ────────────────────
SENTINEL_HUB_CLIENT_ID=your-client-id
SENTINEL_HUB_CLIENT_SECRET=your-client-secret

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────
WHATSAPP_ACCESS_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# ── Africa's Talking (USSD / SMS / Voice IVR) ─────────────────
AFRICASTALKING_API_KEY=your-at-api-key
AFRICASTALKING_USERNAME=your-at-username

# ── Safaricom M-Pesa Daraja ───────────────────────────────────
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_BUSINESS_SHORT_CODE=174379
MPESA_PASSKEY=your-passkey
MPESA_ENVIRONMENT=sandbox            # → production when live
MPESA_CALLBACK_URL=https://your-domain/api/mpesa/callback

# ── Airtel Money ──────────────────────────────────────────────
AIRTEL_CLIENT_ID=your-client-id
AIRTEL_CLIENT_SECRET=your-client-secret
AIRTEL_ENVIRONMENT=staging           # → production when live
AIRTEL_COUNTRY=KE
AIRTEL_CURRENCY=KES

# ── Google Maps ───────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-maps-api-key

# ── Weather — Tomorrow.io ─────────────────────────────────────
TOMORROW_IO_API_KEY=your-tomorrow-api-key
# Open-Meteo is free and requires no key

# ── Web Search — Brave ────────────────────────────────────────
BRAVE_API_KEY=your-brave-api-key

# ── Redis (Celery broker) ─────────────────────────────────────
EKYAN_REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── GitHub ────────────────────────────────────────────────────
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your-token-here

# ═══════════════════════════════════════════════════════════════
# UI & FRONTEND LAYER
# ═══════════════════════════════════════════════════════════════

# ── Figma (Design → Code) ─────────────────────────────────────
FIGMA_PERSONAL_ACCESS_TOKEN=your-figma-pat

# ── Mapbox (GIS / Interactive Maps) ──────────────────────────
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token

# ── Vercel (Hosting — M&E dashboard, agripreneur PWA, portal) ─
VERCEL_TOKEN=your-vercel-token
VERCEL_TEAM_ID=your-team-id
# Vercel project IDs (set after first deploy)
VERCEL_PROJECT_ME_DASHBOARD=
VERCEL_PROJECT_AGRIPRENEUR_PWA=
VERCEL_PROJECT_SUPPLIER_PORTAL=

# ── Expo (React Native / Android agripreneur app) ─────────────
EXPO_TOKEN=your-expo-token
EXPO_ACCOUNT_NAME=your-expo-account
EXPO_PROJECT_SLUG=ekyan-agripreneur

# ── Sentry (Frontend & Backend Error Monitoring) ──────────────
SENTRY_AUTH_TOKEN=your-sentry-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=ekyan-connect
SENTRY_DSN_FRONTEND=https://xxx@oyyy.ingest.sentry.io/zzz
SENTRY_DSN_BACKEND=https://aaa@obbb.ingest.sentry.io/ccc

# ── PostHog (Product Analytics — self-hostable) ───────────────
POSTHOG_API_KEY=phc_your-posthog-key
POSTHOG_HOST=https://app.posthog.com   # or your self-hosted URL
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Puppeteer / Chrome DevTools (Browser Testing) ────────────
PUPPETEER_EXECUTABLE_PATH=            # leave blank to auto-download Chromium

# ── Contentful (Multilingual CMS — advisory content) ──────────
CONTENTFUL_SPACE_ID=your-space-id
CONTENTFUL_ACCESS_TOKEN=your-delivery-token
CONTENTFUL_PREVIEW_TOKEN=your-preview-token
CONTENTFUL_MANAGEMENT_TOKEN=your-management-token
CONTENTFUL_ENVIRONMENT=master

# ── axe DevTools (Accessibility Auditing) ────────────────────
AXE_API_KEY=                          # optional — axe-core runs locally without it

# ── FastAPI Application ───────────────────────────────────────
SECRET_KEY=change-me-to-a-random-256-bit-hex-string
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true                            # → false in production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

