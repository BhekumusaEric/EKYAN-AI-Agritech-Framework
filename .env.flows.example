# WhatsApp Flows credentials — copy to .env.flows and fill in real values
# DO NOT COMMIT .env.flows (it is gitignored)

# Meta access token (24h temp token from App Dashboard, or permanent System User token)
WA_TOKEN=<your_meta_access_token>

# WhatsApp Business Account ID (from App Dashboard → WhatsApp → API Setup)
WABA_ID=<your_whatsapp_business_account_id>

# Phone Number ID (same page as WABA_ID)
WA_PHONE_ID=<your_phone_number_id>

# Local backend URL (change to your deployed URL in production)
EKYAN_API_URL=http://localhost:8000
